{
  "name": "geo-vue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GEO 生成式引擎优化前端管理平台（Vue3 + TypeScript + Vite）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.vue --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\""
  },
  "dependencies": {
    "vue": "^3.4.31",
    "vue-router": "^4.4.0",
    "pinia": "^2.1.7",
    "axios": "^1.7.2",
    "element-plus": "^2.7.6",
    "@element-plus/icons-vue": "^2.3.1",
    "echarts": "^5.5.1",
    "dayjs": "^1.11.11",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "typescript": "^5.4.5",
    "vue-tsc": "^2.0.24",
    "vite": "^5.3.3",
    "sass": "^1.77.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.14.10",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.26.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "prettier": "^3.3.2"
  }
}
